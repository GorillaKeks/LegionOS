{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phone",
  "version": "1.0.2",
  "identifier": "com.phone.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Phone",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../apps/": "apps/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyQjMwRUMwNjUyNUUyOUEKUldTYTRpVmx3QTZ6OGpYNGlFRCtvZ2hZQWlOZFJCa1pQRDZWSEZEZG43QTVCZ1p1TUtad09jeUYK",
      "endpoints": [
        "https://github.com/GorillaKeks/LegionOS/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
